# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# AI Configuration (Mandatory unless running simulation mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Search API Configuration (Optional: falls back to Yahoo Finance Search if missing)
TAVILY_API_KEY=your_tavily_api_key_here

# Broker / Market Data API Configuration (Optional for real-time NSE live feed)
GROWW_API_KEY=your_groww_jwt_or_api_token_here

# Caching Configuration
CACHE_TTL=3600
